[
  {
    "id": "tpl-1",
    "name": "🚀 Start Node Server",
    "shell": "powershell.exe",
    "cwd": "%USERPROFILE%",
    "script": "npm run dev",
    "icon": "🚀"
  },
  {
    "id": "tpl-2",
    "name": "📦 Git Pull",
    "shell": "C:\\Program Files\\Git\\bin\\bash.exe",
    "cwd": "%USERPROFILE%",
    "script": "git pull && git status",
    "icon": "📦"
  },
  {
    "id": "tpl-3",
    "name": "🔍 View Processes",
    "shell": "powershell.exe",
    "cwd": "%USERPROFILE%",
    "script": "Get-Process | Sort-Object CPU -Descending | Select-Object -First 10",
    "icon": "🔍"
  },
  {
    "id": "tpl-4",
    "name": "🧹 Clear NPM Cache",
    "shell": "powershell.exe",
    "cwd": "%USERPROFILE%",
    "script": "npm cache clean --force",
    "icon": "🧹"
  },
  {
    "id": "tpl-5",
    "name": "📁 List Directory",
    "shell": "C:\\Program Files\\Git\\bin\\bash.exe",
    "cwd": "%USERPROFILE%",
    "script": "ls -la",
    "icon": "📁"
  },
  {
    "id": "tpl-6",
    "name": "🌐 Start Local Server",
    "shell": "C:\\Program Files\\Git\\bin\\bash.exe",
    "cwd": "%USERPROFILE%",
    "script": "python -m http.server 8080",
    "icon": "🌐"
  },
  {
    "id": "tpl-7",
    "name": "🔧 View Git Log",
    "shell": "C:\\Program Files\\Git\\bin\\bash.exe",
    "cwd": "%USERPROFILE%",
    "script": "git log --oneline -10",
    "icon": "🔧"
  },
  {
    "id": "tpl-8",
    "name": "📊 Disk Usage",
    "shell": "powershell.exe",
    "cwd": "%USERPROFILE%",
    "script": "Get-PSDrive -PSProvider FileSystem | Select-Object Name,Used,Free | Format-Table",
    "icon": "📊"
  }
]
