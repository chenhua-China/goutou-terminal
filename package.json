{
  "name": "goutou-terminal",
  "version": "1.0.0",
  "description": "🐕 Goutou Terminal - A powerful terminal manager with aliases, templates, and auto-restore",
  "main": "main.js",
  "repository": {
    "type": "git",
    "url": "https://github.com/chenhua-China/goutou-terminal.git"
  },
  "scripts": {
    "start": "electron .",
    "dev": "electron . --enable-logging",
    "build": "electron-builder",
    "build:win": "electron-builder --win",
    "build:portable": "electron-builder --win portable"
  },
  "keywords": [
    "terminal",
    "electron",
    "xterm",
    "xterm.js",
    "node-pty",
    "terminal-manager",
    "workspace",
    "multi-terminal"
  ],
  "author": "Doghead Agent Squad",
  "license": "MIT",
  "devDependencies": {
    "electron": "^41.2.1",
    "electron-builder": "^24.13.3"
  },
  "dependencies": {
    "node-pty": "^1.1.0",
    "xterm": "^5.3.0",
    "xterm-addon-fit": "^0.8.0",
    "xterm-addon-web-links": "^0.9.0"
  },
  "build": {
    "appId": "com.doghead.terminal",
    "productName": "狗头管家终端工作台",
    "directories": {
      "output": "dist"
    },
    "files": [
      "main.js",
      "renderer.js",
      "index.html",
      "styles.css",
      "templates.json",
      "node_modules/**/*"
    ],
    "extraResources": [
      "templates.json"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "forceCodeSigning": false,
      "requestedExecutionLevel": "asInvoker"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "狗头管家终端",
      "runAfterFinish": true,
      "language": "2052"
    },
    "asar": true,
    "asarUnpack": [
      "node_modules/node-pty"
    ],
    "npmRebuild": false,
    "downloadAlternateFFmpeg": false
  }
}
